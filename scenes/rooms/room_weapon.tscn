[node name="RoomWeapon" type="Node2D"]
script = ExtResource("1_room")
# Salle spéciale de donjon (type "treasure/shop room" à la Isaac), une des
# salles générées par DungeonGenerator (Phase 6.1). Contient uniquement
# l'atelier d'arme — l'établi d'alchimie vit dans room_alchemy.tscn, une
# salle distincte : le générateur choisit aléatoirement laquelle des deux
# apparaît dans le donjon, jamais les deux ensemble (cf. game.gd,
# SPECIAL_ROOM_TEMPLATE_PATHS).

